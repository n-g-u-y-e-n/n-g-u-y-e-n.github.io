---
import "../style.css";
import { getCollection } from "astro:content";
import Dock from "../components/Dock.astro";
import SideRays from "../components/SideRays.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import Toc from "../components/Toc.astro";

interface Props {
  title: string;
  description: string;
  contents: { text: string; href: string; depth?: number }[];
}

const { title, description, contents } = Astro.props;
const { pathname } = Astro.url;
const isHome = pathname === "/";
const isBlogView = ["/blog/", "/tags/", "/categories/"].some((prefix) => pathname.startsWith(prefix));
const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime() || a.id.localeCompare(b.id),
);
const recentPosts = posts.slice(0, 5);
const tagCounts = new Map<string, number>();
const categoryCounts = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
  for (const category of post.data.categories) {
    categoryCounts.set(category, (categoryCounts.get(category) ?? 0) + 1);
  }
}
const tags = [...tagCounts].sort(([a], [b]) => a.localeCompare(b));
const categories = [...categoryCounts].sort(([a], [b]) => a.localeCompare(b));
const tocItems = pathname === "/blog/" ? [] : [{ text: "Intro", href: "#intro" }, ...contents];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#09090b" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400..700&display=swap"
      rel="stylesheet"
    />
    <title>{title === "Nguyễn Nhật Nguyên" ? title : `${title} · Nguyễn Nhật Nguyên`}</title>
    <script is:inline>
      // Runs before paint, so a stored light choice never flashes dark first.
      // No stored value means dark, which is the CSS default.
      try {
        var t = localStorage.getItem("theme");
        if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
        if (t === "light") document.querySelector('meta[name="theme-color"]').setAttribute("content", "#fcfcfc");
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#intro">Skip to content</a>
    <div class="top-utils">
      <ThemeToggle />
    </div>
    <SideRays />

    {!isHome && (
      <div class="container masthead">
        <a href="/" class="masthead__home">Nguyễn Nhật Nguyên</a>
        {isBlogView && (
          <>
            <span class="for" aria-hidden="true">/</span>
            <a href="/blog/" class="masthead__section">blog</a>
          </>
        )}
      </div>
    )}

    <main id="intro" class:list={["container", "prose", { "is-home": isHome }]}>
      <slot />
      <slot name="projects" />

      {isBlogView && (
        <section class="browse" aria-label="Browse the blog">
          <nav class="browse__group" aria-labelledby="recent-posts-title">
            <h2 id="recent-posts-title" class="subhead">Recent posts</h2>
            {recentPosts.length > 0 ? (
              <ul class="link-list">
                {recentPosts.map((post) => (
                  <li>
                    <a href={`/blog/${post.id}/`} aria-current={pathname === `/blog/${post.id}/` ? "page" : undefined}>{post.data.title}</a>
                    <time datetime={post.data.date.toISOString()}>{post.data.date.toISOString().slice(0, 10)}</time>
                  </li>
                ))}
              </ul>
            ) : <p>No posts yet.</p>}
          </nav>
          {categories.length > 0 && (
            <nav class="browse__group" aria-labelledby="categories-title">
              <h2 id="categories-title" class="subhead">Categories</h2>
              <ul class="post-tags">
                {categories.map(([category, count]) => (
                  <li><a href={`/categories/${category}/`} aria-current={pathname === `/categories/${category}/` ? "page" : undefined}>{category} <span class="tag-count">{count}</span></a></li>
                ))}
              </ul>
            </nav>
          )}
          {tags.length > 0 && (
            <nav class="browse__group" aria-labelledby="tags-title">
              <h2 id="tags-title" class="subhead">Tags</h2>
              <ul class="post-tags">
                {tags.map(([tag, count]) => (
                  <li><a href={`/tags/${tag}/`} aria-current={pathname === `/tags/${tag}/` ? "page" : undefined}>#{tag} <span class="tag-count">{count}</span></a></li>
                ))}
              </ul>
            </nav>
          )}
        </section>
      )}

      <footer class="site-footer">
        <p>© {new Date().getFullYear()} Nguyễn Nhật Nguyên · <a href="#intro">Back to top ↑</a></p>
      </footer>
    </main>

    {tocItems.length > 1 && <Toc items={tocItems} />}
    <Dock />

    <script>
      // Floating copy button on every code block, adapted from the crd-ui
      // website (MIT). The wrapper keeps the button in place when wide code
      // scrolls inside the pre.
      const COPY_ICON =
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2"></rect><path d="M5 15V5a2 2 0 0 1 2-2h10"></path></svg>';
      const CHECK_ICON =
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>';

      for (const pre of document.querySelectorAll<HTMLElement>("pre.astro-code")) {
        const wrap = document.createElement("div");
        wrap.className = "code-block";
        pre.parentNode!.insertBefore(wrap, pre);
        wrap.appendChild(pre);

        const copyBtn = document.createElement("button");
        copyBtn.type = "button";
        copyBtn.className = "code-copy";
        copyBtn.setAttribute("aria-label", "Copy code");
        copyBtn.innerHTML = COPY_ICON;
        copyBtn.addEventListener("click", async () => {
          await navigator.clipboard.writeText(pre.textContent ?? "");
          copyBtn.classList.add("is-copied");
          copyBtn.innerHTML = CHECK_ICON;
          setTimeout(() => {
            copyBtn.classList.remove("is-copied");
            copyBtn.innerHTML = COPY_ICON;
          }, 1200);
        });
        wrap.appendChild(copyBtn);
      }
    </script>
  </body>
</html>
